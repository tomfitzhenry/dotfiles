"xterm"
   F1

"urxvt"
    F2

"iceweasel"
    F3

"icedove"
    F4

"tom_mpcAdd.sh"
    F5

"xscreensaver-command -activate"
    Scroll_Lock

"scrot"
    Print

"amixer set Master 5%-"
    m:0x0 + c:222

"amixer set Master 5%+"
    m:0x0 + c:223

"amixer set Master toggle"
    m:0x0 + c:227

"mpc toggle"
    KP_Enter

"mpc next"
    Mod2 + KP_Add

"mpc prev"
    Mod2 + KP_Subtract
