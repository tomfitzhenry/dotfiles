alias sx="exec startx -- -nolisten tcp"
alias ls="ls -F --color"
alias c="clear"

alias s="tmux attach-session -t main"

# Convenience
alias irc='ssh -t server tmux attach-session -t main'

alias grep=egrep
alias ack=ack-grep

# Debian stuff
alias sau="sudo sh -c 'aptitude update && aptitude safe-upgrade'"
alias sai="sudo aptitude install"

function create_temp_dir() {
    local ROOTTEMPDIR=~/tmp/
    mkdir -p $ROOTTEMPDIR

    local PREFIX=$1

    if [ -z $PREFIX ];
    then
        local PATTERN="tmp.XXXXXX"
    else
        local PATTERN="$1.XXXXXX"
    fi

    local TEMPDIR=$(mktemp -d --tmpdir=$ROOTTEMPDIR $PATTERN)

    pushd $TEMPDIR
}

alias t="create_temp_dir"

# gpg-agent
if [ -f $HOME/.gpg-agent-info ]; then
    if kill -0 `cut -d: -f 2 $HOME/.gpg-agent-info` 2>/dev/null; then
        GPG_AGENT_INFO=`cat $HOME/.gpg-agent-info`
        export GPG_AGENT_INFO
    fi
else
    if [ -x /usr/bin/gpg-agent ]; then
        eval `gpg-agent --daemon`
        echo $GPG_AGENT_INFO > $HOME/.gpg-agent-info
    fi
fi

if [ -f $HOME/.profile.private ]; then
    . ~/.profile.private
fi

if [ -f $HOME/.profile.local ]; then
    . ~/.profile.local
fi
