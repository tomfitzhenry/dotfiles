#alias sx='startx -- -nolisten tcp >& $HOME/.startx-errors'
alias sx="exec startx -- -nolisten tcp"
alias ls="ls -F --color"

alias sr="tmux attach-session -t main"

# Convenience
alias irc='ssh -t server tmux attach-session -t main'

alias grep=egrep
alias ack=ack-grep

alias c=cd
alias l=ls
alias d=docker
alias s=sudo
alias ss="sudo !!"
alias g=git
alias v=vim

# Debian stuff
alias sau="sudo sh -c 'aptitude update && aptitude safe-upgrade'"
alias sai="sudo aptitude install"
alias acs="apt-cache search"

# gpg-agent
if [ -f $HOME/.gpg-agent-info ]; then
    if kill -0 `cut -d: -f 2 $HOME/.gpg-agent-info` 2>/dev/null; then
        GPG_AGENT_INFO=`cat $HOME/.gpg-agent-info`
        export GPG_AGENT_INFO
    fi
else
    if [ -x /usr/bin/gpg-agent ]; then
        eval `gpg-agent --daemon`
        echo $GPG_AGENT_INFO > $HOME/.gpg-agent-info
    fi
fi

if [ -f $HOME/.profile.private ]; then
    . ~/.profile.private
fi

if [ -f $HOME/.profile.local ]; then
    . ~/.profile.local
fi

PATH=$PATH:$HOME/.rvm/bin # Add RVM to PATH for scripting
[[ -s "$HOME/.rvm/scripts/rvm" ]] && source "$HOME/.rvm/scripts/rvm" # Load RVM into a shell session *as a function*
