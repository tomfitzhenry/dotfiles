# Write your default config options here!

# Use to increase volume of quiet videos
softvol=1
softvol-max=1200

# Normalise volume, so explosions are the same volume as conversations
# http://www.oneweb.co.uk/mythtv/2009/03/normalise-movie-volume/
#
# Scale tempo, so increasing speed doesn't cause speakers to sound like chipmunks
# https://shreevatsa.wordpress.com/2009/05/29/mplayer-changing-speed-without-changing-pitch-avoiding-the-chipmunk-effect/
af=volnorm,scaletempo

fs=yes # default to fullscreen
