" Originally copied from Tim Monks

set nocompatible
if &term =~ "screen"
	set term=xterm
endif
set history=50
set autowrite
set showcmd
set wildmenu " shows tab completion menu during a command
set backspace=2 "mean that you can always backspace

filetype plugin on
filetype on
set modeline

for f in split(glob('~/.vim/rc/*.vim'), '\n')
    exe 'source' f
endfor
