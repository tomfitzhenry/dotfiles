[general]
accounts = zoho,gmail
pythonfile=~/.config/offlineimap/config.py

[Account zoho]
localrepository = Local
remoterepository = Remote

[Repository Local]
type = Maildir
localfolders = ~/backups/zoho/

[Repository Remote]
type = IMAP
ssl = yes
remotehost = imap.zoho.com
remoteuser = tom@tom-fitzhenry.me.uk
remotepasseval = keyring.get_password("mail.zoho.com","tom@tom-fitzhenry.me.uk")
readonly = True
sslcacertfile=/usr/local/etc/openssl/cert.pem

[Account gmail]
localrepository = Gmail-Local
remoterepository = Gmail-Remote

[Repository Gmail-Local]
type = Maildir
localfolders = ~/backups/gmail-thomasfitzhenry

[Repository Gmail-Remote]
type = IMAP
ssl = yes
remotehost = imap.gmail.com
remoteuser = thomasfitzhenry@gmail.com
remotepasseval = keyring.get_password("imap.gmail.com","thomasfitzhenry@gmail.com")
readonly = True
sslcacertfile=/usr/local/etc/openssl/cert.pem
