function create_temp_dir() {
    local ROOTTEMPDIR=~/tmp/
    mkdir -p $ROOTTEMPDIR

    local PREFIX=$1

    if [ -z $PREFIX ];
    then
        local PATTERN="tmp"
    else
        local PATTERN="$1"
    fi

    local TEMPDIR=$(TMPDIR=$ROOTTEMPDIR mktemp -d -t $PATTERN)

    pushd $TEMPDIR
}

alias t="create_temp_dir"
