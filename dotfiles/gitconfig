[user]
    name = Tom Fitzhenry
    email = git@tom-fitzhenry.me.uk

[alias]
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    co = checkout
    st = status
    d = diff

[color]
    branch = auto
    diff = auto
    interactive = auto
    status = auto

[help]
    format = web

[url "git@github.com:"]
    insteadOf = "gh:"
    insteadOf = "github:"

[url "git@github.com:tomfitzhenry/"]
    insteadOf = "ght:"

[push]
    default = tracking

[core "include"]
    path = ~/.gitconfig.local
[core]
	excludesfile = ~/.gitignore.global
[github]
	user = tomfitzhenry
