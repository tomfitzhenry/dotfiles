#!/bin/sh
set -eu
set -o pipefail

USERNAME=$1
DIRECTORY=$2

FEEDLY_API_TOKEN=$(security find-generic-password -s feedly.com -a "$USERNAME" -g 2>&1 | grep password | awk '{print $2}' | tr -d '"')

# http://blog.feedly.com/2013/06/29/opml-export/
curl --silent http://feedly.com/v3/opml?feedlyToken="$FEEDLY_API_TOKEN" > "$DIRECTORY"/feeds.opml
