#!/bin/bash
set -eu
set -o pipefail

BACKUP_DIR=~/backups

function backupDirectory {
    local PATH_TO_DIRECTORY="$1"
    local ARCHIVE_NAME=20150831.$(basename "$PATH_TO_DIRECTORY")."$(date -u +"%Y%m%dT%H%M%S")"
    echo "$ARCHIVE_NAME"
    (
        cd "$PATH_TO_DIRECTORY"
        tarsnap -c \
		-v \
		-f "$ARCHIVE_NAME" \
		--cachedir ~/.tarsnap-cache \
		--keyfile ~/.tarsnap-write.key \
		--print-stats \
		--checkpoint-bytes 1G \
		--humanize-numbers \
	        ./*
    )
}

set +eu
[ -z "$1" ]
ALL_ARCHIVES=$?
set -eu

if [ $ALL_ARCHIVES -eq 0 ]; then
    for DIR in $BACKUP_DIR/*; do
	backupDirectory "$DIR"
    done
else
    backupDirectory "$1"
fi
