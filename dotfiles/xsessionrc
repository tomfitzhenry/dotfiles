
if [ "$(hostname)" = "tom-MS-7599" ]; then
    unity-settings-daemon &
    sleep 3
    xrandr --output DFP2 --auto --right-of CRT1 --auto
elif [ "$(hostname)" = "tom-MacBookPro" ]; then
    gnome-settings-daemon &
    sleep 3
    xrandr --output DP-2 --off
fi

xmodmap ~/.xmodmaprc
ssh-agent &
wmname LG3D &
dropbox start &

btsync &

redshift &
trayer --edge top --align right --SetDockType true --SetPartialStrut true \
       --expand true --width 10 --transparent true --tint 0x000000 --height 17 --monitor 1 &
nm-applet &
