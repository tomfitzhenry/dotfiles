export EDITOR="emacsclient -t"
export VISUAL="emacsclient -c"

alias e="emacsclient -n"

HISTSIZE=-1 HISTFILESIZE=-1

export PATH=~/.local/bin:$PATH

if [ ! $TERM = "dumb" ]; then
        # debian
	if [ -f /usr/share/doc/fzf/examples/key-bindings.bash ]; then
		source /usr/share/doc/fzf/examples/key-bindings.bash
	fi

        # nixos
	if command -v fzf-share >/dev/null; then
		source "$(fzf-share)/key-bindings.bash"
		source "$(fzf-share)/completion.bash"
	fi
fi

if [ -e "/run/current-system/sw/share/bash-completion/completions/autojump.bash" ] ;  then
	source "/run/current-system/sw/share/bash-completion/completions/autojump.bash"
fi

# Needed for SSH's U2F?
export GIT_SSH_COMMAND="ssh"
