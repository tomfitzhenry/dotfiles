#!/usr/bin/env python
import os
import os.path
import shutil
import sys

import gst
import gobject
import optparse

def err_quit(msg):
    print >>sys.stderr, "%s: %s" % (parser.get_prog_name(), msg)
    sys.exit(1)

def on_eos(bus, msg):
    mainloop.quit()

def on_error(bus, msg):
    error = msg.parse_error()
    mainloop.quit()
    pipeline.set_state(gst.STATE_NULL)
    err_quit(error[1])

def aac(inputfile, outputfile):
    transcode(inputfile, outputfile, "faac ! mp4mux")

def mp3(inputfile, outputfile):
    # Note that as vbr-quality increases, expected bitrate decreases.
    transcode(inputfile, outputfile, "lame vbr=new vbr-quality=0 ! id3v2mux")

def vorbis(quality):
    return lambda input, output: transcode(input, output,
                                 "vorbisenc quality=%f ! oggmux" % quality)

def transcode(inputfile, outputfile, opts):
    try:
        pipeline = gst.parse_launch("""
            filesrc name=in ! decodebin ! audioconvert !
            %s ! filesink name=out
        """ % opts)

        src = pipeline.get_by_name('in')
        src.set_property('location', inputfile)

        sink = pipeline.get_by_name('out')
        sink.set_property('location', outputfile)

        bus = pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect('message::eos', on_eos)
        bus.connect('message::error', on_error)


        pipeline.set_state(gst.STATE_PLAYING)
        mainloop.run()

    except KeyboardInterrupt:
        err_quit("Interrupted on user request.")
    finally:
        pipeline.set_state(gst.STATE_NULL)

codecs = [
        # Description DirectoryName FileExt FunctionName
        ("Vorbis Q2.5", "vorbis_q2.5", "ogg", vorbis(quality=0.25)),
        ("Vorbis Q3", "vorbis_q3", "ogg", vorbis(quality=0.3)),
        ("Vorbis Q4", "vorbis_q4", "ogg", vorbis(quality=0.4)),
        ("Vorbis Q5", "vorbis_q5", "ogg", vorbis(quality=0.5)),
        ("Vorbis Q6", "vorbis_q6", "ogg", vorbis(quality=0.6)),
        ("Vorbis Q8", "vorbis_q8", "ogg", vorbis(quality=0.8)),
        ("MP3",       "mp3",       "mp3", mp3),
        ("AAC",       "aac",       "aac", aac),
]

# recursively encode all files and directories in losslessDir into lossyDir
def traverse(losslessDir, lossyDir, codec):
    for file in os.listdir(losslessDir):

        losslessPath = "%s/%s" % (losslessDir, file)
        lossyPath = "%s/%s" % (lossyDir, file)

        if os.path.isdir(losslessPath):
            if file not in os.listdir(lossyDir):
                newDir = "%s/%s" % (lossyDir, file)
                os.mkdir(newDir)
            traverse(losslessPath, lossyPath, codec)

        else:
            # is there a better way to check if a file is a FLAC file than this?
            if file[-5:] == ".flac":
                lossyFile = "%s" % lossyPath[:-4] + codec[2]
                if not os.path.exists(lossyFile):
                    print "%s to %s" % (losslessPath, lossyFile)
                    codec[3](losslessPath, lossyFile)
            else:
                if not os.path.exists(lossyPath):
                    print "%s to %s" % (losslessPath, lossyPath)
                    shutil.copy(losslessPath, lossyPath)

if __name__ == "__main__":
    defaultBaseDir = os.getenv("MUSIC_STORE_DIR")

    gobject.threads_init()
    mainloop = gobject.MainLoop()
    
    option_list = [
        optparse.make_option("-q", "--quiet",
                             action="store_false", dest="verbose", default=True,
                             help="be quiet"),
        optparse.make_option("-d", "--directory",
                             default=defaultBaseDir,
                             metavar="DIR", help="the music base directory"),
    ]

    parser = optparse.OptionParser("%prog", option_list=option_list)

    (options, args) = parser.parse_args()

    baseDir = options.directory

    for codec in codecs:
        losslessDir = "%s/flac" % baseDir
        lossyDir = "%s/%s" % (baseDir, codec[1])
        if os.path.isdir(lossyDir):
            traverse(losslessDir, lossyDir, codec)
