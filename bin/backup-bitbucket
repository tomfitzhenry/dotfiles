#!/bin/sh
set -eu
set -o pipefail

USERNAME=$1
BACKUP_DIR=$2

mkdir -p $BACKUP_DIR
cd $BACKUP_DIR

BITBUCKET_PASSWORD=$(security find-generic-password -s bitbucket.org -a $USERNAME -g 2>&1 | grep password | awk '{print $2}' | tr -d '"')

curl \
    --silent --fail \
    --user $USERNAME:$BITBUCKET_PASSWORD \
    https://api.bitbucket.org/1.0/user/repositories \
    | jq -r 'map(.slug) | join("\n")' | while read repo
do
    REPO_URL=https://$USERNAME:$BITBUCKET_PASSWORD@bitbucket.org/$USERNAME/$repo.git
    DIR=$(basename $REPO_URL)
    if [ ! -d $DIR ]; then
        git clone --mirror --quiet $REPO_URL
    else
        git -C $DIR remote update > /dev/null
    fi
done
