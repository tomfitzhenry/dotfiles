#!/bin/sh

set -eu

BACKUP_DIR=~/Private/tarsnap/gitolite

mkdir -p $BACKUP_DIR
cd $BACKUP_DIR

CONNECTION_IS_OPEN="false"

mktempfifo() {
    local TEMPDIR=$(mktemp -d)
    local FIFO_NAME=$TEMPDIR/fifo
    mkfifo $FIFO_NAME
    echo $FIFO_NAME
    # leaks directories. Oh well.
}

for i in $(ssh gitolite info | tail -n+3 | awk '{print $2}' | dos2unix --);
do

    # My gitolite server seems to hang during connection establishment about 10% of
    # the time.
    # Solution: Reduce the number of connection establishments,
    #           by reusing connections.
    if [ ${CONNECTION_IS_OPEN} = "false" ]; then
        echo "Opening connection to gitolite server, which will be reused."
        FIFO_FILENAME=$(mktempfifo)
        # Issuing the 'git-upload-pack' command to gitolite will cause the
        # connection to remain open until we kill it later.
        # Putting SSH into the background causes SSH, which relies on stdin,
        # to suspend. Solution: Change stdin to a pipe which we never fill. Muhaha.
        cat $FIFO_FILENAME | ssh -T gitolite git-upload-pack "'/${i}'" &
        PID=$!
        CONNECTION_IS_OPEN="true"
    fi


    echo $i

    if [ ! -d "${i}" ]; then
        git clone ssh://gitolite/$i;
    else
        cd $i;
        git pull;
        cd ..;
    fi
done

# Clean up
if [ ! -z $(ps aux | awk '{print $2}' | grep $PID) ]; then
    echo "Closing SSH connection at PID $PID"
    /bin/kill $PID
else
    echo "No SSH process at PID $PID anymore..."
fi
