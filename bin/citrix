#!/bin/sh

# Runs citrix for a specified ICA file
# example usage: $ citrix ie6
#
# which uses ~/bin/citrix_apps/ie6 to connect to citrix

set -eu

BASE=$HOME/bin/citrix_apps

ICA_FILE=$BASE/$1.ica
TEMP_ICA_FILE=$ICA_FILE.backup

echo $ICA_FILE
echo $TEMP_ICA_FILE
cp $ICA_FILE $TEMP_ICA_FILE

nohup /usr/lib/ICAClient/wfica $TEMP_ICA_FILE > /dev/null 2>&1 &
