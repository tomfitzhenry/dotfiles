#!/bin/sh

# Recursively compares the difference between my Vorbis and FLAC collections.

set -e

DIR1=/files/public/music/flac/
DIR2=/files/public/music/vorbis_q2.5/

if [[ ! -d $DIR1 ]]; then
    echo "$DIR1 doesn't exist. Exiting."
    exit 1
fi

if [[ ! -d $DIR2 ]]; then
    echo "$DIR2 doesn't exist. Exiting."
    exit 1
fi

TREE1=`mktemp`
TREE2=`mktemp`

tree $DIR1 | sed 's/\.flac$//' > $TREE1
tree $DIR2 | sed 's/\.ogg$//' > $TREE2

diff -u $TREE1 $TREE2 || true

rm $TREE1 $TREE2
