#!/usr/bin/python

import sys
import os
import pycurl

API_KEY = os.environ.get("IMGUR_ID")

c = pycurl.Curl()
values = [
          ("key", API_KEY),
          ("image", (c.FORM_FILE, sys.argv[1]))]
# OR:     ("image", "http://example.com/example.jpg"))]

c.setopt(c.URL, "http://imgur.com/api/upload.xml")
c.setopt(c.HTTPPOST, values)

c.perform()
c.close()
