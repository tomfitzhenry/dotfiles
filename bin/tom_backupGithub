#!/bin/sh

set -eu

BACKUP_DIR=~/Private/tarsnap/github

mkdir -p $BACKUP_DIR
cd $BACKUP_DIR

for i in $(curl --silent http://github.com/api/v2/json/repos/show/tomfitzhenry | /bin/grep -Po '"url":.*?[^\\]",' | awk -F\" '{print $4}');
do
    if [ ! -d $(basename $i) ]; then
        git clone $i;
    else
        cd $(basename $i);
        git pull;
        cd ..;
    fi
done
