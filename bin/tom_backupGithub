#!/bin/sh

set -eu

BACKUP_DIR=~/Private/tarsnap/github

mkdir -p $BACKUP_DIR
cd $BACKUP_DIR

JSON=$(curl --silent --fail https://api.github.com/users/tomfitzhenry/repos)

echo "${JSON}" | /bin/grep -Po '"git_url":.*?[^\\]",' | awk -F\" '{print $4}' | while read repo
do
    LOCAL_DIR_NAME=$(basename $repo | sed 's/\.git$//')
    printf "$LOCAL_DIR_NAME \n\t"
    if [ ! -d $LOCAL_DIR_NAME ]; then
        git clone $repo;
    else
        cd $LOCAL_DIR_NAME
        git pull;
        cd ..;
    fi
done
