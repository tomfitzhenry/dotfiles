#!/bin/sh

set -eu

BACKUP_DIR=~/Private/tarsnap/github

mkdir -p $BACKUP_DIR
cd $BACKUP_DIR

JSON=$(curl --silent --fail https://api.github.com/users/tomfitzhenry/repos)

echo "${JSON}" | /bin/grep -Po '"git_url":.*?[^\\]",' | awk -F\" '{print $4}' | while read i
do
    LOCAL_DIR_NAME=$(basename $i | sed 's/\.git$//')
    if [ ! -d $LOCAL_DIR_NAME ]; then
        git clone $i;
    else
        cd $LOCAL_DIR_NAME
        git pull;
        cd ..;
    fi
done
