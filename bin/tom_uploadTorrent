#!/usr/bin/perl

use MIME::Base64 ();
use SOAP::Lite ();

@stores = qw/public.zoink.it torrage.com/;

$| = 1;

open(FILE, @ARGV[0]) or die "$!";
while (read(FILE, $buf, 60*57)) { $tor.=MIME::Base64::encode($buf); }
close(FILE);

foreach (@stores) {
    print $_.": ";
    $infoHash = SOAP::Lite->service("http://$_/api/torrage.wsdl")->cacheTorrent($tor);
    print $infoHash."\n";
}
