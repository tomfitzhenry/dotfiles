#!/usr/bin/python

##############################################################################
# Clones all bitbucket repos (including private repos) for a specified user.
#
# Arguments:
#     1. Bitbucket username
##############################################################################

import json
import os
import getpass
import re
import sys
import urllib

def is_word(string):
    return re.match("^[a-zA-z0-9\\-]*$", string)

def check_is_word(string):
    if not is_word(string):
        raise Exception("String %s is not a valid word" % string)
    return string

if __name__ == "__main__":

    if len(sys.argv) <= 1:
        print "You must specify a bitbucket username as the first argument."
        sys.exit(1)

    username = check_is_word(sys.argv[1])
    password = getpass.getpass("Enter bitbucket user %s's password: " % username)

    response = urllib.urlopen('https://%s:%s@api.bitbucket.org/1.0/user/repositories' % (username, password))
    json = json.loads(response.read())

    for repo in json:
        repo_name = check_is_word(repo['slug'])

        command = "hg clone https://%s:%s@bitbucket.org/%s/%s" % (username, password, username, repo_name)

        print "Cloning %s" % repo_name
        os.popen(command)

