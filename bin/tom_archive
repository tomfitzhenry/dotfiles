#!/bin/sh

# Saves stdin into $XDG_DOCUMENTS_DIR/$DATE-$1

set -eu

DATE_FORMAT="%Y%m%dT%H%M%S"
ARCHIVE_DIRECTORY=${XDG_DOCUMENTS_DIR-$HOME/Documents}

DATE=$(date +"$DATE_FORMAT")

NOTE_NAME=$1

mkdir -p $ARCHIVE_DIRECTORY

(
# This is required so that whitespace is preserved
# (see <http://tldp.org/LDP/abs/html/internalvariables.html#IFSREF> )
IFS='\n'
while read stdin; do
   echo "$stdin" >> $ARCHIVE_DIRECTORY/$DATE-$NOTE_NAME
done
)
