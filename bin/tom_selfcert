#!/bin/sh

# Installs a cert file.
#
# Example usage: tom_selfcert foo.crt

set -e

CERTDIR=/etc/ssl/certs
CERT=$1

if [ -z $CERT ]; then
    echo "Requires one argument."
    echo "For example, $0 foo.crt"
    exit;
fi

if [ ! -f $CERT ]; then
    echo "$CERT: File does not exist.";
    exit;
fi

CERTNAME=`basename $CERT`

cp $CERT $CERTDIR

cd $CERTDIR

HASH=`openssl x509 -noout -hash -in $CERTNAME`
for i in `seq 0 9`; do
    HASHLINKNAME="${HASH}.$i";
    if [ ! -f $HASHLINKNAME ]; then
        ln -s $CERTNAME $HASHLINKNAME
        exit;
    fi
done

# If this point in the code is reached then each of $HASHLINKNAME.[0-9] existed,
# in which I don't think installing $CERT is possible. (Can double digit numbers
# be used?)
echo "Fail: Each of $HASH.[0-9] already existed."
exit 1
