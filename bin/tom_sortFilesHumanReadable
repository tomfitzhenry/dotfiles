#!/bin/sh

# A script to calculate disk usages for the current directory
# listing them in size-order in human-readable form.

# Give it /any/ argument to show hidden files

set -e

if [ ! $1 = "" ];
then
    # This one includes hidden files
    du --all --max-depth 1 | sort -n | cut -f 2 | xargs -d'\n' du -h --max-depth 0 --all
else
    # This one ignores hidden files
    du --all --max-depth 0 * | sort -n | cut -f 2 | xargs -d'\n' du -h --max-depth 0 --all
fi
