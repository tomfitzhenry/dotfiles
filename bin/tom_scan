#!/usr/bin/env ruby

require 'tempfile'

abort("Insufficient params") unless ARGV.length == 3

mode = ARGV[0]
filename = ARGV[1]
page = ARGV[2]

opts = case mode
when "low"
  { mode: "gray", resolution: "300" }
when "high"
  { mode: "gray", resolution: "600" }
when "colour"
  { mode: "color", resolution: "600" }
else
  abort("Unrecognised mode")
end

opts[:format] = "tiff"

def unique_filename(directory, prefix, suffix=".tiff")
  file = Tempfile.new([prefix + "-", suffix], directory)
  filepath = file.path
  file.unlink
  filepath
end

system "mkdir -p #{filename}"

system "scanimage -x 210 -y 297 #{opts.collect { |k, v| "--#{k}=#{v}" }.join " " } > #{unique_filename(filename, page)}"
