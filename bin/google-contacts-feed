#!/usr/bin/env python
from optparse import OptionParser
import gdata.contacts.service

def google_contacts(username, password):
    client = gdata.contacts.service.ContactsService()
    client.ClientLogin(username, password)

    query = gdata.contacts.service.ContactsQuery()
    query.max_results = 2000
    return client.GetContactsFeed(query.ToUri())

def password(password_filename):
    try:
        file = open(password_filename, 'r')
        return file.read()
    finally:
        if (file is not None):
            file.close()

if __name__ == "__main__":
    parser = OptionParser()
    parser.add_option("-u", "--username")
    parser.add_option("-p", "--password-file", dest="passwordfile")

    (options, args) = parser.parse_args()

    if options.username is None:
        print "'username' is mandatory"
        parser.print_help()
        sys.exit(-1)

    if options.passwordfile is None:
        print "'password' is mandatory"
        parser.print_help()
        sys.exit(-1)

    print google_contacts(options.username, password(options.passwordfile))
