#!/bin/sh

set -eu

option=${1-"view"}

URL=http://download.guardian.co.uk/g24/Topstories.pdf
DEFAULT_SAVE_LOCATION=~/tmp2/guardian-`date +%Y%m%d`.pdf

SAVE_LOCATION=${2-$DEFAULT_SAVE_LOCATION}

HELP=\
"`basename $0` view          Open news in a PDF viewer
`basename $0` print         Print news (using lpr)
`basename $0` save          Save news to $DEFAULT_SAVE_LOCATION
`basename $0` save foo.pdf  Save news to foo.pdf
`basename $0` help          Outputs help";

case "$option" in
    "view")
        evince $URL;
    ;;
    "print")
        wget $URL -O- | lpr;
    ;;
    "save")
        wget $URL -O $SAVE_LOCATION;
    ;;
    "help")
        echo "$HELP"
    ;;
    *)
        echo "\"$1\" is not a command I recognise. Please use one of:"
        echo "$HELP"
esac
