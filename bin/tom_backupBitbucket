#!/bin/sh

set -eu

BACKUP_DIR=~/Private/tarsnap/bitbucket

mkdir -p $BACKUP_DIR
cd $BACKUP_DIR

for i in $(curl --silent --user tomfitzhenry:$BITBUCKET_PASSWORD https://api.bitbucket.org/1.0/user/repositories | /bin/grep -Po '"slug":.*?[^\\]",' | awk -F\" '{print $4}');
do
    if [ ! -d $(basename $i) ]; then
        git clone https://tomfitzhenry:$BITBUCKET_PASSWORD@bitbucket.org/$i;
    else
        cd $(basename $i);
        git pull;
        cd ..;
    fi
done
