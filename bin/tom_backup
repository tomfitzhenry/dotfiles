#!/usr/bin/runhaskell

import Control.Monad(forM_, filterM)
import Data.List (sort)
import System.Directory (getDirectoryContents)
import System.Environment (getArgs)
import System.Posix.Files (getFileStatus, isRegularFile)
import System.Process (createProcess, shell, waitForProcess)

main :: IO ()
main = do
    args <- getArgs
    let commands = parseCommands args
    forM_ commands executeCommand

executeCommand :: Command -> IO ()
executeCommand Read  = executeScriptsInDirectory "/home/tom/bin/backup/read/"
executeCommand Write = executeScriptsInDirectory "/home/tom/bin/backup/write/"

executeScriptsInDirectory :: FilePath -> IO ()
executeScriptsInDirectory path = do
    relativeFiles <- getDirectoryContents path
    let nonHiddenRelativeFiles = filter (\s -> head s /= '.') relativeFiles
    let absoluteFiles = map ((++) path) nonHiddenRelativeFiles
    regularFiles <- filterM isRegularF absoluteFiles
    scripts <- filterM isExecutable regularFiles
    let sortedScripts = sort scripts
    forM_ sortedScripts executeScript

executeScript :: FilePath -> IO ()
executeScript path = do
    (_,_,_,processHandle) <- createProcess $ shell path
    waitForProcess processHandle
    return ()

isRegularF :: FilePath -> IO Bool
isRegularF path = do
    status <- getFileStatus path
    return $ isRegularFile status

isExecutable :: FilePath -> IO Bool
isExecutable path = return True

parseCommands :: [String] -> [Command]
parseCommands [] = parseCommands ["sync"]
parseCommands ("read":[]) = [Read]
parseCommands ("write":[]) = [Write]
parseCommands ("read":"write":[]) = [Read, Write]
parseCommands ("sync":[]) = [Read, Write]

data Command = Read
             | Write
