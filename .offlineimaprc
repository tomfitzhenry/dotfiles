# Sample minimal config file.  Copy this to ~/.offlineimaprc and edit to
# suit to get started fast.

[general]
accounts = googleapps, gmail-tomfitzyuk, gmail-tomfitzy, gmail-thomasfitzhenry, uwcs, warwick, lightstar

# tomfitzyuk@gmail.com
[Account gmail-tomfitzyuk]
localrepository = gmail-tomfitzyuk-local
remoterepository = gmail-tomfitzyuk-remote

[Repository gmail-tomfitzyuk-local]
type = Maildir
localfolders = ~/mail5/tomfitzyuk@gmail.com/

[Repository gmail-tomfitzyuk-remote]
type = IMAP
ssl = yes
remotehost = imap.gmail.com
remoteuser = tomfitzyuk


