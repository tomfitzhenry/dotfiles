account blueyonder
from tom@tom-fitzhenry.me.uk
host smtp.blueyonder.co.uk
protocol smtp

account gmail
host smtp.gmail.com
port 587
protocol smtp
auth on
from tomfitzyuk@gmail.com
user tomfitzyuk@gmail.com
tls on
tls_starttls on
tls_trust_file ~/.certs/ThawtePremiumServerCA_b64.txt

account uwcs
from tom@tom-fitzhenry.me.uk
host mail.uwcs.co.uk
port 8025
protocol smtp
user tomfitzyuk
auth on
tls on
tls_starttls on
tls_trust_file /etc/ssl/certs/mail.uwcs.co.uk.crt
tls_certcheck on

account default : uwcs
