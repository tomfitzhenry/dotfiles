# Default behaviour
folder-hook . \
    'bind index r reply ;\
    bind pager r reply ;\
    bind index m mail ;\
    bind index m mail ;\
    ignore * ;\
    unignore Date: '

unset ignore_list_reply_to

# Behaviour for lists
folder-hook list/* '\
    ignore *; \
    set pager_index_lines=8; \
    bind index r list-reply; \
    bind pager r list-reply'

folder-hook list/compsoc-announce '\
    macro pager m <mail>compsoc-announce@warwickcompsoc.co.uk ;\
    macro index m <mail>compsoc-announce@warwickcompsoc.co.uk'

folder-hook list/compsoc-discuss '\
    macro pager m <mail>compsoc-discuss@warwickcompsoc.co.uk; \
    macro index m <mail>compsoc-discuss@warwickcompsoc.co.uk'

folder-hook list/compsoc-exec '\
    macro pager m <mail>compsoc-exec@warwickcompsoc.co.uk; \
    macro index m <mail>compsoc-exec@warwickcompsoc.co.uk'

folder-hook list/compsoc-techteam '\
    macro pager m <mail>compsoc-techteam@warwickcompsoc.co.uk; \
    macro index m <mail>compsoc-techteam@warwickcompsoc.co.uk'

folder-hook list/bbc-backstage '\
  bind index r reply; \
  bind pager r reply; \
  macro pager m <mail>backstage@lists.bbc.co.uk; \
  macro index m <mail>backstage@lists.bbc.co.uk'

