set realname="Tom Fitzhenry"
set from="tom@tom-fitzhenry.me.uk"

alternates "tomfitzyuk@gmail.com|T.Fitzhenry@warwick.ac.uk|tomfitzyuk@uwcs.co.uk|tom@fitzhenry.name|tom@tom-fitzhenry.me.uk"

set folder="~/mail"
set spoolfile=+inbox
set record=+sent
set postponed=+postponed
set mbox_type=Maildir

set sendmail="/usr/bin/msmtp"
set editor='/usr/bin/vim "+set spell"'
set print_command="/usr/bin/a2ps"

set alias_file="~/.aliases"
set mailcap_path="~/.mailcap"
set signature="~/.signature"

alternative_order text/enriched text/plain text/html
auto_view text/html application/x_pgp_message

source "~/.mutt/folder-hooks"
source "~/.mutt/headers"
source "~/.mutt/macros"
source "~/.mutt/mailboxes"
source "~/.mutt/options"
source "~/.mutt/pgp"
source "~/.mutt/subscriptions"
